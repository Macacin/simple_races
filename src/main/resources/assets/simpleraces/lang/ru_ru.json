  ,"gui.simpleraces.human_select.tooltip_dwarves_are_stout_skilled_craft.extended": "* \u00a7f\u00a7l\u0427\u0438\u0441\u0442\u0430\u044f \u043e\u0441\u043d\u043e\u0432\u0430\u00a7r: \u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0435\u0442 \u0432\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043b\u0438 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\n* \u00a7e\u00a7l\u0412\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c\u00a7r: \u0441\u043f\u0440\u0438\u043d\u0442 \u043d\u0435 \u0442\u0440\u0430\u0442\u0438\u0442 \u0433\u043e\u043b\u043e\u0434\n* \u00a76\u00a7l\u0413\u0438\u0431\u043a\u043e\u0441\u0442\u044c\u00a7r: \u0441\u0438\u043b\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0435 \u0432 \u0433\u043e\u0442\u043e\u0432\u043e\u043c \u0431\u043e\u043d\u0443\u0441\u0435, \u0430 \u0432 \u0442\u043e\u043c, \u043a\u0430\u043a \u0431\u044b\u0441\u0442\u0440\u043e \u043e\u043d \u043f\u0440\u0438\u0432\u044b\u043a\u0430\u0435\u0442 \u043a \u043d\u0443\u0436\u043d\u043e\u043c\u0443 \u0441\u0442\u0438\u043b\u044e \u0438\u0433\u0440\u044b"
  ,"gui.simpleraces.human_select.tooltip_passive_mine_faster_in_dark.extended": "* \u00a77\u00a7l\u0421\u043a\u0440\u044b\u0442\u044b\u0435 \u043d\u0430\u0432\u044b\u043a\u0438\u00a7r: \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043f\u043e\u043d\u0435\u043c\u043d\u043e\u0433\u0443 \u043f\u0440\u0438\u0441\u043f\u043e\u0441\u0430\u0431\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a \u0442\u043e\u043c\u0443, \u0447\u0435\u043c \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f\n* \u00a72\u00a7l\u0428\u0430\u0445\u0442\u0451\u0440\u0441\u043a\u0430\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u00a7r: \u0435\u0441\u043b\u0438 \u043c\u043d\u043e\u0433\u043e \u043a\u043e\u043f\u0430\u0442\u044c, \u043e\u0447\u0435\u043d\u044c \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u0442\u0451\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0434\u043e\u0431\u044b\u0447\u0438\n* \u00a7c\u00a7l\u041e\u0440\u0443\u0436\u0435\u0439\u043d\u0430\u044f \u0432\u044b\u0443\u0447\u043a\u0430\u00a7r: \u0447\u0430\u0441\u0442\u044b\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u0435 \u0443\u0434\u0430\u0440\u044b \u043e\u0434\u043d\u0438\u043c \u0438 \u0442\u0435\u043c \u0436\u0435 \u0442\u0438\u043f\u043e\u043c \u043e\u0440\u0443\u0436\u0438\u044f \u0441\u043b\u0435\u0433\u043a\u0430 \u043f\u043e\u0432\u044b\u0448\u0430\u044e\u0442 \u0443\u0440\u043e\u043d \u0438\u043c\u0435\u043d\u043d\u043e \u0438\u043c\n* \u00a79\u00a7l\u0421\u0442\u0440\u0435\u043b\u043a\u043e\u0432\u0430\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u00a7r: \u0447\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0441\u0442\u0440\u0435\u043b\u044f\u0435\u0442, \u0442\u0435\u043c \u0447\u0443\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435 \u043b\u0435\u0442\u044f\u0442 \u0435\u0433\u043e \u0441\u0442\u0440\u0435\u043b\u044b\n* \u00a78\u00a7l\u0412\u0430\u0436\u043d\u043e\u00a7r: \u0440\u043e\u0441\u0442 \u044d\u0442\u0438\u0445 \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u043e\u0447\u0435\u043d\u044c \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u0439, \u0430 \u0431\u043e\u043d\u0443\u0441\u044b \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435"
  ,"gui.simpleraces.gargoyle_select.tooltip_dwarves_are_stout_skilled_craft": "\u00a78\u041a\u0430\u043c\u0435\u043d\u044c \u0441\u043e \u043c\u043d\u043e\u0433\u0438\u043c\u0438 \u043b\u0438\u0446\u0430\u043c\u0438\u00a7r"
  ,"gui.simpleraces.gargoyle_select.tooltip_passive_mine_faster_in_dark": "\u00a77\u0421\u0438\u043b\u0430 \u0432 \u0441\u043c\u0435\u043d\u0435 \u0441\u0442\u043e\u0435\u043a\u00a7r"
  ,"gui.simpleraces.gargoyle_select.tooltip_dwarves_are_stout_skilled_craft.extended": "- \u0413\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u0441\u0438\u043b\u044c\u043d\u0430 \u043d\u0435 \u0441\u0442\u0430\u0442\u0430\u043c\u0438, \u0430 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0439 \u0441\u043c\u0435\u043d\u043e\u0439 \u0441\u0442\u043e\u0435\u043a\n- \u041f\u0440\u0438 \u0434\u043e\u043b\u0433\u043e\u043c \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 \u0442\u0435\u043b\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043e\u043a\u0430\u043c\u0435\u043d\u0435\u0432\u0430\u0442\u044c\n* \u00a7a\u00a7l\u0411\u0430\u0441\u0442\u0438\u043e\u043d\u00a7r: \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0437\u0430\u0449\u0438\u0442\u043d\u0430\u044f \u0441\u0442\u0430\u0442\u0443\u044f\n* \u00a7c\u00a7l\u041a\u043e\u0433\u0442\u0438\u00a7r: \u043e\u0445\u043e\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0442\u043a\u0443 \u0434\u043e\u0431\u044b\u0447\u0438 \u0438 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u044e\n* \u00a79\u00a7l\u0428\u043f\u0438\u043b\u044c\u00a7r: \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0443\u0434\u0430\u0440\u044b \u0441 \u0432\u044b\u0441\u043e\u0442\u044b\n* \u00a76\u00a7l\u0425\u0438\u043c\u0435\u0440\u0430\u00a7r: \u043a\u043e\u043d\u0442\u0440\u0430, \u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0441\u0440\u044b\u0432 \u0432 \u043e\u0445\u043e\u0442\u0443"
  ,"gui.simpleraces.gargoyle_select.tooltip_passive_mine_faster_in_dark.extended": "* \u00a7a\u00a7l\u0411\u0430\u0441\u0442\u0438\u043e\u043d\u00a7r \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0433\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u0441\u0442\u043e\u0438\u0442 \u0431\u0435\u0437 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043e\u043a\u043e\u043b\u043e 6 \u0441\u0435\u043a\u0443\u043d\u0434. \u0421\u0442\u043e\u0439\u043a\u0430 \u0441\u0438\u043b\u044c\u043d\u043e \u0440\u0435\u0436\u0435\u0442 \u0432\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0443\u0440\u043e\u043d, \u0441\u0443\u0436\u0430\u0435\u0442 \u043e\u0431\u0437\u043e\u0440 \u0438 \u043c\u0435\u0434\u043b\u0438\u0442, \u0430 \u0432\u044b\u0445\u043e\u0434 \u0438\u0437 \u043d\u0435\u0451 \u0432 \u041a\u043e\u0433\u0442\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 3 \u0441\u0435\u043a\u0443\u043d\u0434\u044b.\n* \u00a7c\u00a7l\u041a\u043e\u0433\u0442\u0438\u00a7r \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u0440\u0430 \u0432 \u0441\u043f\u0440\u0438\u043d\u0442\u0435 \u0438\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0430 \u0438\u0437 \u0411\u0430\u0441\u0442\u0438\u043e\u043d\u0430. \u041f\u0435\u0440\u0432\u0430\u044f \u0446\u0435\u043b\u044c \u0432 \u044d\u0442\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u041c\u0435\u0442\u043a\u0443 \u0434\u043e\u0431\u044b\u0447\u0438, \u0430 \u0434\u0430\u043b\u044c\u0448\u0435 \u0441\u0442\u043e\u0439\u043a\u0430 \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442 \u0437\u0430 \u0443\u0434\u0430\u0440\u044b \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0439 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438: \u0432\u043f\u043b\u043e\u0442\u043d\u0443\u044e \u0441\u043b\u0430\u0431\u043e, \u0441 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u0441 \u0434\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0420\u044b\u0432\u043e\u043a.\n* \u00a79\u00a7l\u0428\u043f\u0438\u043b\u044c\u00a7r \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0430\u0442\u0430\u043a\u0438 \u0432 \u0432\u043e\u0437\u0434\u0443\u0445\u0435. \u0412 \u044d\u0442\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 \u0433\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u043c\u043e\u0436\u0435\u0442 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u0441 \u044d\u043b\u0438\u0442\u0440\u0430\u043c\u0438 \u043f\u043e \u0434\u0432\u043e\u0439\u043d\u043e\u043c\u0443 \u043d\u0430\u0436\u0430\u0442\u0438\u044e \u043f\u0440\u044b\u0436\u043a\u0430, \u0438\u043c\u0435\u0435\u0442 \u0448\u0438\u0440\u0435 \u043e\u0431\u0437\u043e\u0440 \u0438 \u0431\u044c\u0451\u0442 \u0431\u043e\u043b\u044c\u043d\u0435\u0435 \u043f\u0440\u0438 \u0430\u0442\u0430\u043a\u0435 \u0441\u0432\u0435\u0440\u0445\u0443, \u043d\u043e \u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0445\u0440\u0443\u043f\u043a\u043e\u0439.\n* \u00a76\u00a7l\u0425\u0438\u043c\u0435\u0440\u0430\u00a7r \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0433\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u0441\u0438\u0434\u0438\u0442 \u0438 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0443\u0434\u0430\u0440, \u043d\u0435 \u0430\u0442\u0430\u043a\u0443\u044f \u043f\u0435\u0440\u0435\u0434 \u044d\u0442\u0438\u043c \u043e\u043a\u043e\u043b\u043e 1.5 \u0441\u0435\u043a\u0443\u043d\u0434. \u041e\u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043e\u043a\u043d\u043e \u043f\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f: \u0435\u0441\u043b\u0438 \u0432 \u043e\u0442\u0432\u0435\u0442 \u0443\u0441\u043f\u0435\u0442\u044c \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u0432\u0440\u0430\u0433\u0430, \u0446\u0435\u043b\u044c \u043f\u0443\u0433\u0430\u0435\u0442\u0441\u044f, \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u041c\u0435\u0442\u043a\u0443 \u0434\u043e\u0431\u044b\u0447\u0438 II, \u0430 \u0433\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u0441\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u041a\u043e\u0433\u0442\u0438.\n* \u0421\u0438\u043b\u0430 \u0440\u0430\u0441\u044b \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0440\u043e\u0442\u0430\u0446\u0438\u044e \u0441\u0442\u043e\u0435\u043a. \u0415\u0441\u043b\u0438 \u0434\u043e\u043b\u0433\u043e \u0441\u0438\u0434\u0435\u0442\u044c \u0432 \u043e\u0434\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435, \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043a\u043e\u043f\u0438\u0442\u0441\u044f \u041e\u043a\u0430\u043c\u0435\u043d\u0435\u043d\u0438\u0435."
  ,"gui.simpleraces.race_select.tooltip_difficulty_scale": "\u0428\u043a\u0430\u043b\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438\n\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u0430 \u0440\u0430\u0441\u0430 \u043a \u043e\u0441\u0432\u043e\u0435\u043d\u0438\u044e."
  ,"gui.simpleraces.dwarf_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 1/4\n\u041e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0440\u0430\u0441. \u0414\u0432\u043e\u0440\u0444 \u0434\u0430\u0435\u0442 \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0435 \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u043d\u0443\u0441\u044b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0433\u043e \u043b\u0435\u0433\u043a\u043e \u043e\u0441\u0432\u043e\u0438\u0442\u044c."
  ,"gui.simpleraces.elf_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 1/4\n\u041f\u0440\u043e\u0441\u0442\u0430\u044f \u0432 \u043e\u0441\u0432\u043e\u0435\u043d\u0438\u0438 \u0440\u0430\u0441\u0430 \u0441 \u044f\u0441\u043d\u044b\u043c\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u0442\u043e\u0440\u043e\u043d\u0430\u043c\u0438. \u042d\u043b\u044c\u0444 \u0445\u043e\u0440\u043e\u0448\u043e \u0438\u0433\u0440\u0430\u0435\u0442\u0441\u044f \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u0441\u043b\u043e\u0436\u043d\u043e\u0439 \u0440\u043e\u0442\u0430\u0446\u0438\u0438 \u0438 \u0442\u043e\u043d\u043a\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f."
  ,"gui.simpleraces.merfolk_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 3/4\n\u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043a\u0438. \u041c\u0435\u0440\u0444\u043e\u043b\u043a \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u0435\u043d \u0432 \u0432\u043e\u0434\u0435, \u043d\u043e \u043d\u0430 \u0441\u0443\u0448\u0435 \u0435\u0433\u043e \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u0438 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0432 \u0433\u043e\u043b\u043e\u0432\u0435."
  ,"gui.simpleraces.orc_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 3/4\n\u0420\u0430\u0441\u0430 \u043f\u0440\u043e \u0442\u0435\u043c\u043f \u0438 \u0440\u0438\u0441\u043a. \u041e\u0440\u043a \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u0435\u043d, \u0435\u0441\u043b\u0438 \u0438\u0433\u0440\u043e\u043a \u0443\u043c\u0435\u0435\u0442 \u0432\u043e\u0432\u0440\u0435\u043c\u044f \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c \u044f\u0440\u043e\u0441\u0442\u044c \u0438 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u0442\u044c \u043f\u043e\u0434 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0435."
  ,"gui.simpleraces.dragon_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 3/4\n\u0414\u0440\u0430\u043a\u043e\u043d \u0434\u0430\u0435\u0442 \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0431\u043e\u0435\u0432\u044b\u0435 \u043e\u043a\u043d\u0430, \u043d\u043e \u0438\u0445 \u043d\u0443\u0436\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u041f\u0435\u0440\u0435\u0433\u0440\u0435\u0432 \u0438 \u0443\u044f\u0437\u0432\u0438\u043c\u043e\u0441\u0442\u044c \u043a \u0432\u043e\u0434\u0435 \u0431\u044b\u0441\u0442\u0440\u043e \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0437\u0430 \u043d\u0435\u0431\u0440\u0435\u0436\u043d\u0443\u044e \u0438\u0433\u0440\u0443."
  ,"gui.simpleraces.fairy_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 4/4\n\u041e\u0447\u0435\u043d\u044c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0441\u0430. \u0424\u0435\u044f \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043a\u0438, \u0442\u0430\u0439\u043c\u0438\u043d\u0433\u0430 \u043f\u043e\u043b\u0435\u0442\u0430 \u0438 \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e\u0439 \u0438\u0433\u0440\u044b \u0441 \u043e\u0447\u0435\u043d\u044c \u043c\u0430\u043b\u044b\u043c \u0437\u0430\u043f\u0430\u0441\u043e\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f."
  ,"gui.simpleraces.serpentin_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 4/4\n\u0421\u0438\u043b\u0430 \u0441\u0435\u0440\u043f\u0435\u043d\u0442\u0438\u043d\u044b \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0438 \u0437\u0435\u043b\u044c\u044f. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043a \u0431\u043e\u044e \u0438 \u043d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u0440\u0430\u043d\u0435\u0435, \u0440\u0430\u0441\u0430 \u043e\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0441\u043b\u0430\u0431\u0435\u0435."
  ,"gui.simpleraces.werewolf_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 2/4\n\u0420\u0430\u0441\u0430 \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u041e\u0431\u043e\u0440\u043e\u0442\u0435\u043d\u044c \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0443\u0447\u0435\u0442\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0443\u0442\u043e\u043a \u0438 \u0444\u043e\u0440\u043c\u044b, \u043d\u043e \u0432 \u0446\u0435\u043b\u043e\u043c \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e."
  ,"gui.simpleraces.halfdead_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 1/4\n\u041e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u044f\u043c\u043e\u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0440\u0430\u0441. \u041f\u043e\u043b\u0443\u043c\u0435\u0440\u0442\u0432\u044b\u0439 \u0438\u0433\u0440\u0430\u0435\u0442 \u043e\u0442 \u0437\u0430\u043f\u0430\u0441\u0430 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f, \u0430\u0443\u0440\u044b \u0438 \u0434\u043e\u0431\u0438\u0432\u0430\u043d\u0438\u0439 \u0431\u0435\u0437 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u043a."
  ,"gui.simpleraces.gargoyle_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 4/4\n\u041e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0440\u0430\u0441 \u0432 \u043c\u043e\u0434\u0435. \u0413\u0430\u0440\u0433\u0443\u043b\u044c\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0441\u0442\u043e\u0435\u043a, \u0440\u0438\u0442\u043c\u0430 \u0431\u043e\u044f \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0439 \u0441\u043c\u0435\u043d\u044b \u0444\u043e\u0440\u043c."
  ,"gui.simpleraces.human_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 2/4\n\u0423 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0435\u0442 \u0432\u0440\u043e\u0436\u0434\u0451\u043d\u043d\u044b\u0445 \u0431\u043e\u0435\u0432\u044b\u0445 \u0442\u0440\u044e\u043a\u043e\u0432 \u0438\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0441\u043e\u0432\u044b\u0445 \u0431\u043e\u043d\u0443\u0441\u043e\u0432, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0433\u043e \u0441\u0438\u043b\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u044f, \u043e\u043f\u044b\u0442\u0430 \u0438 \u0441\u0442\u0438\u043b\u044f \u0438\u0433\u0440\u044b."
  ,"gui.simpleraces.arachna_select.tooltip_difficulty_scale": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c: 2/4\n\u041d\u0443\u0436\u043d\u043e \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u044b\u043a\u043d\u0443\u0442\u044c \u043a \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044e \u043f\u043e \u0441\u0442\u0435\u043d\u0430\u043c \u0438 \u0441\u0432\u043e\u0438\u043c \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044f\u043c, \u043d\u043e \u0432 \u0446\u0435\u043b\u043e\u043c \u0440\u0430\u0441\u0430 \u043e\u0441\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e."
